# Local development only. Replace these public examples in your untracked .env.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=18080
FRONTEND_ORIGIN=http://localhost:5173
POSTGRES_DB=ifri_admissions
POSTGRES_USER=ifri_local
POSTGRES_PASSWORD=replace-dev-postgres-password
# Native client / optional compose.native.yaml; base Compose does not publish PostgreSQL.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
# Native client / optional compose.native.yaml; base Compose does not publish Redis.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-dev-redis-password
REDIS_TLS=false
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_ROOT_USER=ifri-local
MINIO_ROOT_PASSWORD=replace-dev-minio-password
MINIO_BUCKET=ifri-documents
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# Draft cookie session duration in seconds (7 days); production must set explicitly.
DRAFT_SESSION_TTL_SECONDS=604800

# API S3 account limited to documents; root credentials remain with initializer only.
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_ACCESS_KEY=ifri-documents-api
S3_SECRET_KEY=replace-dev-s3-password
DOCUMENT_MAX_BYTES=10485760

# Internal OCR transport; replace example with a randomly generated secret (>=32 chars).
OCR_INTERNAL_SECRET=replace-dev-ocr-secret-at-least-32-characters
OCR_INTERNAL_URL=http://127.0.0.1:8081
OCR_MIN_CONFIDENCE=0.85
OCR_ANALYSIS_TIMEOUT_SECONDS=120
OCR_PAGE_TIMEOUT_SECONDS=30
OCR_MAX_PAGES=10

# Bounded scan path; defaults evaluated separately from native PDFs.
OCR_SCAN_DPI=300
OCR_SCAN_RETRY_DPI=350
OCR_SCAN_MAX_PASSES=3
# Parallel Tesseract processes for BAC table cells (1-16); empty = min(4, CPU count).
OCR_CELL_WORKERS=
# BAC numeric cells read by RapidOCR (model pinned in the image); false = Tesseract digits.
OCR_RAPIDOCR_ENABLED=true
